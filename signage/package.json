{
  "name": "daangn-signage",
  "version": "1.0.0",
  "description": "디지털 사이니지 - 3개 HDMI 화면 미디어 재생 프로그램 (미러링 / 비디오월 / 각각 모드)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.daangn.signage",
    "productName": "Daangn Signage",
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "DaangnSignage-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "files": ["**/*", "!dist/**"]
  }
}
